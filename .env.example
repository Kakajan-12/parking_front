# ====================================================================
# Core URLs
# ====================================================================

# Base URL exposed to the frontend (used for API calls from browser).
# Dev: http://localhost:8000
# Prod: https://api.yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Base server URL (used internally by server-side code).
# Dev: http://127.0.0.1:8000
# Prod: https://api.yourdomain.com
BASE_SERVER_URL=http://127.0.0.1:8000

# Host for serving media files (no trailing slash).
# Dev: http://localhost:8000
# Prod: https://cdn.yourdomain.com
NEXT_PUBLIC_MEDIA_HOST=http://localhost:8000  # Without trailing slash

# Public URL of the website (used for SEO, redirects, canonical links).
# Dev: http://localhost:3000
# Prod: https://www.yourdomain.com
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Domain name of the site (used for cookies, redirects, etc.).
# Dev: localhost:3000
# Prod: yourdomain.com
NEXT_PUBLIC_SITE_DOMAIN=localhost:3000


# ====================================================================
# Routing / Cookies
# ====================================================================

# Router base URL (leave empty if not using custom router server).
# Prod: set if you use a dedicated router service.
NEXT_PUBLIC_ROUTER_URL=

# Path for storing cookies (default is root `/`).
NEXT_PUBLIC_COOKIE_PATH=/

# Whether cookies should be `Secure` (HTTPS only).
# Dev: false
# Prod: true (required for HTTPS)
NEXT_PUBLIC_ENABLE_COOKIE_SECURE=false


# ====================================================================
# Project settings
# ====================================================================

# Name of the project (used in UI titles/logs).
NEXT_PUBLIC_PROJECT_NAME="admin-panel"

# Port for running Next.js dev server.
# Dev: 3000
# Prod: handled by hosting provider (e.g., Vercel/NGINX).
PORT=3000

# ────────────────────────────────
# 🏢 Company Info
# ────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME="Company name"
NEXT_PUBLIC_SITE_NAME="Site name"

# ====================================================================
# Security / CSP
# ====================================================================

# SessionsTable Security Policy string.
# Strongly recommended in production to prevent XSS attacks.
# Example: "default-src 'self'; img-src *; script-src 'self' 'unsafe-inline' cdn.yourdomain.com;"
CSP_POLICY=

# ====================================================================
# Debugging / Telemetry
# ====================================================================

# Next.js telemetry.
# Dev: 0 (disabled) or 1 (enabled)
# Prod: 0 (recommended to disable telemetry in production)
NEXT_TELEMETRY_DEBUG=0

# Cache debugging for Incremental Static Regeneration.
# Dev: 1 for debugging
# Prod: 0
NEXT_PRIVATE_DEBUG_CACHE=0


# ====================================================================
# CORS / Origins
# ====================================================================

# Allowed origins for CORS (comma-separated).
# Dev: "127.0.0.1,localhost"
# Prod: "yourdomain.com,www.yourdomain.com"
ALLOWED_DEV_ORIGINS="127.0.0.1,localhost"

# ────────────────────────────────
# 🖼️ Image Optimization (Sharp)
# ────────────────────────────────
# If sharp is installed but cannot be resolved (common in Docker/CI environments),
# set the NEXT_SHARP_PATH to the location of sharp inside node_modules.
# Example: export NEXT_SHARP_PATH=/tmp/node_modules/sharp
# Then run: next build
# Finally restart the server with:
#   next start                (for production mode)
#   node .next/standalone/server.ts  (for standalone mode)

NEXT_SHARP_PATH=